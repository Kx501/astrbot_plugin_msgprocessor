{
  "schema_version": 5,
  "rules": [
    {
      "id": "inside_brackets",
      "enabled": true,
      "priority": 10,
      "limits": { "max_matches": 8 },
      "pipeline": [
        {
          "id": "locate",
          "config": {
            "matcher": {
              "type": "anchor_slice",
              "start": { "literal": "【", "occurrence": 0, "inclusive": false },
              "end": { "literal": "】", "occurrence": 0, "inclusive": false }
            },
            "region": { "kind": "match" }
          }
        },
        { "id": "prepend", "config": { "prefix": "[译]" } },
        { "id": "append", "config": { "text": "◆" } }
      ]
    },
    {
      "id": "whole_message_prepend",
      "enabled": false,
      "priority": 8,
      "pipeline": [{ "id": "prepend", "config": { "prefix": "[整段]" } }]
    },
    {
      "id": "llm_split_by_marker",
      "enabled": false,
      "priority": 9,
      "pipeline": [
        {
          "id": "marker",
          "config": { "literal": "---", "action": "split", "delete_literal": true }
        }
      ]
    },
    {
      "id": "block_stale_news",
      "enabled": false,
      "priority": 12,
      "pipeline": [
        {
          "id": "guard",
          "config": {
            "op": "date_outside_days",
            "days": 7,
            "when_true": "block",
            "when_false": "pass"
          }
        }
      ]
    },
    {
      "id": "block_stale_news_by_field",
      "enabled": false,
      "priority": 11,
      "limits": { "max_matches": 1 },
      "pipeline": [
        {
          "id": "locate",
          "config": {
            "matcher": {
              "type": "regex",
              "pattern": "发布日期[:：]\\s*(\\d{4}-\\d{2}-\\d{2})"
            },
            "region": { "kind": "group", "index": 1 }
          }
        },
        {
          "id": "guard",
          "config": {
            "op": "date_outside_days",
            "days": 7,
            "format": "%Y-%m-%d",
            "when_true": "block",
            "when_false": "pass"
          }
        }
      ]
    },
    {
      "id": "block_high_cvss",
      "enabled": false,
      "priority": 10,
      "limits": { "max_matches": 1 },
      "pipeline": [
        {
          "id": "locate",
          "config": {
            "matcher": {
              "type": "regex",
              "pattern": "CVSS[:：]\\s*([0-9.]+)"
            },
            "region": { "kind": "group", "index": 1 }
          }
        },
        {
          "id": "guard",
          "config": {
            "op": "number_gte",
            "value": 9,
            "when_true": "block",
            "when_false": "pass"
          }
        }
      ]
    },
    {
      "id": "goto_date_branch",
      "enabled": false,
      "priority": 11,
      "pipeline": [
        {
          "id": "guard",
          "label": "s1",
          "config": {
            "op": "date_outside_days",
            "days": 7,
            "format": "%Y-%m-%d",
            "when_true": "goto",
            "when_true_goto": "s4",
            "when_false": "goto",
            "when_false_goto": "s2"
          }
        },
        {
          "id": "prepend",
          "label": "s2",
          "config": { "prefix": "[新] " }
        },
        {
          "id": "guard",
          "label": "s3",
          "config": {
            "op": "number_gte",
            "value": 0,
            "when_true": "halt",
            "when_false": "halt"
          }
        },
        {
          "id": "prepend",
          "label": "s4",
          "config": { "prefix": "[旧] " }
        }
      ]
    },
    {
      "id": "simple_prefix",
      "enabled": true,
      "priority": 5,
      "pipeline": [
        {
          "id": "locate",
          "config": {
            "matcher": {
              "type": "simple",
              "op": "startswith",
              "value": "/echo ",
              "ignore_case": false
            },
            "region": { "kind": "match" }
          }
        },
        { "id": "replace", "config": { "from": "/echo ", "to": "ECHO:" } }
      ]
    },
    {
      "id": "simple_prepend_whole_message",
      "enabled": false,
      "priority": 1,
      "pipeline": [{ "id": "prepend", "config": { "prefix": "[tag] " } }]
    },
    {
      "id": "block_unresolved_marker",
      "enabled": false,
      "priority": 15,
      "pipeline": [
        {
          "id": "marker",
          "config": { "literal": "【待填】", "action": "block" }
        }
      ]
    },
    {
      "id": "replace_marker_fallback",
      "enabled": false,
      "priority": 6,
      "pipeline": [
        {
          "id": "marker",
          "config": {
            "literal": "【待填】",
            "action": "replace",
            "replacement": "（待填）"
          }
        }
      ]
    },
    {
      "id": "review_chat_blanklines",
      "enabled": false,
      "priority": 1,
      "pipeline": [
        {
          "id": "guard",
          "config": {
            "op": "regex_search",
            "pattern": "\\n\\s*\\n",
            "when_true": "goto",
            "when_true_goto": "fix",
            "when_false": "pass"
          }
        },
        {
          "id": "review_llm",
          "label": "fix",
          "config": {
            "prompt": "以下是即将发到聊天平台的回复。若含连续空行：\n- 若是文章/长文排版，保持原样\n- 若是日常闲聊且应分多条发送，用单独一行的 --- 分隔各段，去掉多余空行\n只输出修正后正文。\n\n{{text}}"
          }
        },
        {
          "id": "marker",
          "config": {
            "literal": "---",
            "action": "split",
            "delete_literal": true
          }
        }
      ]
    },
    {
      "id": "render_image_example",
      "enabled": false,
      "priority": 1,
      "pipeline": [
        {
          "id": "guard",
          "config": {
            "op": "regex_search",
            "pattern": "^/render\\s",
            "when_true": "goto",
            "when_true_goto": "render",
            "when_false": "pass"
          }
        },
        {
          "id": "replace",
          "config": {
            "from": "^/render\\s*",
            "to": "",
            "regex": true
          }
        },
        {
          "id": "render_image",
          "label": "render",
          "config": {
            "method": "POST",
            "url": "https://example.com/render",
            "body_json": "{\"text\":\"{{text}}\"}",
            "timeout_s": 15
          }
        }
      ]
    },
    {
      "id": "strip_marker_in_brackets",
      "enabled": false,
      "priority": 7,
      "limits": { "max_matches": 8 },
      "pipeline": [
        {
          "id": "locate",
          "config": {
            "matcher": {
              "type": "anchor_slice",
              "start": { "literal": "【", "occurrence": 0, "inclusive": false },
              "end": { "literal": "】", "occurrence": 0, "inclusive": false }
            },
            "region": { "kind": "match" }
          }
        },
        {
          "id": "marker",
          "config": { "literal": "[待填]", "action": "delete" }
        }
      ]
    }
  ]
}
