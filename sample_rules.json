{
  "schema_version": 4,
  "rules": [
    {
      "id": "inside_brackets",
      "enabled": true,
      "priority": 10,
      "limits": { "max_matches": 8 },
      "steps": [
        {
          "id": "match_block",
          "config": {
            "matcher": {
              "type": "anchor_slice",
              "start": { "literal": "【", "occurrence": 0, "inclusive": false },
              "end": { "literal": "】", "occurrence": 0, "inclusive": false }
            },
            "region": { "kind": "match" },
            "steps": [
              { "id": "prepend", "config": { "prefix": "[译]" } },
              { "id": "append", "config": { "text": "◆" } }
            ]
          }
        }
      ]
    },
    {
      "id": "whole_message_passthrough",
      "enabled": false,
      "priority": 8,
      "limits": { "max_matches": 1 },
      "steps": [
        {
          "id": "match_block",
          "config": {
            "matcher": { "type": "passthrough" },
            "region": { "kind": "match" },
            "steps": [{ "id": "prepend", "config": { "prefix": "[整段]" } }]
          }
        }
      ]
    },
    {
      "id": "llm_split_by_marker",
      "enabled": false,
      "priority": 9,
      "limits": { "max_matches": 1 },
      "steps": [
        {
          "id": "match_block",
          "config": {
            "matcher": { "type": "passthrough" },
            "region": { "kind": "match" },
            "steps": [
              { "id": "split", "config": { "marker": "---", "delete_marker": true } }
            ]
          }
        }
      ]
    },
    {
      "id": "block_stale_news",
      "enabled": false,
      "priority": 12,
      "limits": { "max_matches": 1 },
      "steps": [
        {
          "id": "match_block",
          "config": {
            "matcher": { "type": "passthrough" },
            "region": { "kind": "match" },
            "steps": [
              {
                "id": "guard",
                "config": {
                  "op": "date_older_than",
                  "days": 7,
                  "in": "region",
                  "when_true": "block",
                  "when_false": "pass"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "block_stale_news_by_field",
      "enabled": false,
      "priority": 11,
      "limits": { "max_matches": 1 },
      "steps": [
        {
          "id": "match_block",
          "config": {
            "matcher": {
              "type": "regex",
              "pattern": "发布日期[:：]\\s*(\\d{4}-\\d{2}-\\d{2})"
            },
            "region": { "kind": "group", "index": 1 },
            "steps": [
              {
                "id": "guard",
                "config": {
                  "op": "date_older_than",
                  "days": 7,
                  "format": "%Y-%m-%d",
                  "in": "region",
                  "when_true": "block",
                  "when_false": "pass"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "block_high_cvss",
      "enabled": false,
      "priority": 10,
      "limits": { "max_matches": 1 },
      "steps": [
        {
          "id": "match_block",
          "config": {
            "matcher": {
              "type": "regex",
              "pattern": "CVSS[:：]\\s*([0-9.]+)"
            },
            "region": { "kind": "group", "index": 1 },
            "steps": [
              {
                "id": "guard",
                "config": {
                  "op": "number_gte",
                  "value": 9,
                  "in": "region",
                  "when_true": "block",
                  "when_false": "pass"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "goto_length_branch",
      "enabled": false,
      "priority": 11,
      "limits": { "max_matches": 1 },
      "steps": [
        {
          "id": "match_block",
          "config": {
            "matcher": { "type": "passthrough" },
            "region": { "kind": "match" },
            "steps": [
              {
                "id": "guard",
                "label": "s1",
                "config": {
                  "op": "length_gt",
                  "value": 10,
                  "in": "region",
                  "when_true": "goto",
                  "when_true_goto": "s4",
                  "when_false": "goto",
                  "when_false_goto": "s2"
                }
              },
              {
                "id": "prepend",
                "label": "s2",
                "config": { "prefix": "[短] " }
              },
              {
                "id": "guard",
                "label": "s3",
                "config": {
                  "op": "length_gte",
                  "value": 0,
                  "when_true": "stop_rule",
                  "when_false": "stop_rule"
                }
              },
              {
                "id": "prepend",
                "label": "s4",
                "config": { "prefix": "[长] " }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "simple_prefix",
      "enabled": true,
      "priority": 5,
      "steps": [
        {
          "id": "match_block",
          "config": {
            "matcher": {
              "type": "simple",
              "op": "startswith",
              "value": "/echo ",
              "ignore_case": false
            },
            "region": { "kind": "match" },
            "steps": [
              { "id": "replace", "config": { "from": "/echo ", "to": "ECHO:" } }
            ]
          }
        }
      ]
    }
  ]
}
